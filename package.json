{
  "name": "imgdown",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "dev": "bun --filter @imgdown/app dev",
    "build": "bun --filter @imgdown/app build",
    "start": "bun --filter @imgdown/app start",
    "typecheck": "bun check",
    "lint": "oxlint --deny-warnings apps packages",
    "test": "bun test",
    "dup": "jscpd --config .jscpd.json"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "jscpd": "^5.4.3",
    "oxlint": "^1.93.0",
    "typescript": "^7.0.2"
  }
}
