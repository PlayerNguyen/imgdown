{
  "name": "@imgdown/app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run build && bun --watch server/index.ts",
    "build": "bun run build:client && bun run build:css",
    "build:client": "bun scripts/build.ts",
    "build:css": "tailwindcss -i ./src/styles.css -o ./public/styles.css --minify",
    "start": "NODE_ENV=production bun run build && NODE_ENV=production bun server/index.ts"
  },
  "dependencies": {
    "@imgdown/db": "workspace:*",
    "@imgdown/media": "workspace:*",
    "@imgdown/shared": "workspace:*",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.5"
  }
}
